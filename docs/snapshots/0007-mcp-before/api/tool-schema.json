{
  "schemaVersion": "0.1.0",
  "status": "draft",
  "description": "Draft Git-backed text storage; messaging via file conventions.",
  "mcp": {
    "endpoint": "/mcp",
    "tools": "tools/list exposes tools only; tools/call uses the shared service."
  },
  "authentication": {
    "public": "No key required.",
    "private": "Space-scoped bearer key: read permits read/list/history; write permits all. Transport credentials only.",
    "rateControls": "Shared limits across clients/transports; admin overrides per space."
  },
  "tools": [
    {
      "name": "read",
      "description": "Read text at HEAD or revision; returns snapshot state.",
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": true
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "space": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*){0,7}$",
            "description": "Case-sensitive relative path."
          },
          "revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        },
        "required": [
          "space",
          "path"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "space": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
          },
          "state": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$",
            "description": "Snapshot commit hash."
          },
          "file": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f]{32}$",
                "description": "Stable across edits/moves."
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*){0,7}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "protected": {
                "type": "boolean"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "path",
              "bytes",
              "protected",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "space",
          "state",
          "file"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "write",
      "description": "Create/replace text. Root README.md is immutable (case-insensitive).",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": true
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "space": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*){0,7}$",
            "description": "Case-sensitive relative path."
          },
          "text": {
            "type": "string",
            "description": "UTF-8; no NUL; byte limits apply."
          },
          "ifInState": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$",
            "description": "State from read/list; must equal HEAD. On state_mismatch, re-read before retrying."
          },
          "createOnly": {
            "type": "boolean",
            "default": false,
            "description": "Fail if path exists."
          }
        },
        "required": [
          "space",
          "path",
          "text",
          "ifInState"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "space": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
          },
          "oldState": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "newState": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "file": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f]{32}$",
                "description": "Stable across edits/moves."
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*){0,7}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "protected": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "path",
              "bytes",
              "protected"
            ],
            "additionalProperties": false
          },
          "created": {
            "type": "boolean"
          },
          "changed": {
            "type": "boolean"
          }
        },
        "required": [
          "space",
          "oldState",
          "newState",
          "file",
          "created",
          "changed"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "list",
      "description": "List files and snapshot state; folders are implicit.",
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": true
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "space": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
          },
          "prefix": {
            "type": "string",
            "maxLength": 241,
            "pattern": "^([A-Za-z0-9][A-Za-z0-9._-]*/){0,7}$",
            "default": "",
            "description": "Folder prefix ending in /; empty selects all."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "cursor": {
            "type": "string",
            "description": "Previous nextCursor; keep other arguments unchanged."
          }
        },
        "required": [
          "space"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "space": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
          },
          "state": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$",
            "description": "Snapshot commit hash."
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$",
                  "description": "Stable across edits/moves."
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*){0,7}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "protected": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "path",
                "bytes",
                "protected"
              ],
              "additionalProperties": false
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "space",
          "state",
          "files",
          "nextCursor"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "move",
      "description": "Atomic same-space file move; preserves ID/text. Destination must be absent. No directory moves. Root README.md is immutable (case-insensitive).",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": true
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "space": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
          },
          "from": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*){0,7}$",
            "description": "Existing case-sensitive relative path."
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*){0,7}$",
            "description": "Absent case-sensitive relative path."
          },
          "ifInState": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$",
            "description": "State from read/list; must equal HEAD. On state_mismatch, re-read before retrying."
          }
        },
        "required": [
          "space",
          "from",
          "to",
          "ifInState"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "space": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
          },
          "oldState": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "newState": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "file": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f]{32}$",
                "description": "Stable across edits/moves."
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*){0,7}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "protected": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "path",
              "bytes",
              "protected"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "space",
          "oldState",
          "newState",
          "file"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "history",
      "description": "File history across moves, newest first. Read old content using entry path+revision.",
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": true
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "space": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
          },
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$",
            "description": "Stable file ID from read/list."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "cursor": {
            "type": "string",
            "description": "Previous nextCursor; keep other arguments unchanged."
          }
        },
        "required": [
          "space",
          "id"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "space": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
          },
          "state": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$",
            "description": "Snapshot commit hash."
          },
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "revision": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*){0,7}$"
                },
                "operation": {
                  "type": "string",
                  "enum": [
                    "create",
                    "write",
                    "move"
                  ]
                },
                "timestamp": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "revision",
                "path",
                "operation",
                "timestamp"
              ],
              "additionalProperties": false
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "space",
          "state",
          "id",
          "entries",
          "nextCursor"
        ],
        "additionalProperties": false
      }
    }
  ],
  "restMappings": {
    "read": {
      "method": "GET",
      "path": "/api/v1/spaces/{space}/file",
      "query": [
        "path",
        "revision"
      ]
    },
    "write": {
      "method": "PUT",
      "path": "/api/v1/spaces/{space}/file",
      "query": [
        "path"
      ],
      "body": [
        "text",
        "ifInState",
        "createOnly"
      ]
    },
    "list": {
      "method": "GET",
      "path": "/api/v1/spaces/{space}/files",
      "query": [
        "prefix",
        "limit",
        "cursor"
      ]
    },
    "move": {
      "method": "POST",
      "path": "/api/v1/spaces/{space}/move",
      "body": [
        "from",
        "to",
        "ifInState"
      ]
    },
    "history": {
      "method": "GET",
      "path": "/api/v1/spaces/{space}/history",
      "query": [
        "id",
        "limit",
        "cursor"
      ]
    }
  },
  "errorSchema": {
    "type": "object",
    "properties": {
      "error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "invalid_request",
              "unauthorized",
              "forbidden",
              "protected_file",
              "not_found",
              "state_mismatch",
              "destination_exists",
              "payload_too_large",
              "rate_limited",
              "storage_limit",
              "queue_full",
              "internal_error"
            ]
          },
          "message": {
            "type": "string"
          },
          "currentState": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "retryAfterSeconds": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "error"
    ],
    "additionalProperties": false
  },
  "errorNotes": "state_mismatch includes currentState; rate_limited/queue_full include retryAfterSeconds (REST: Retry-After). MCP errors: isError=true + text JSON; success: structuredContent per outputSchema."
}
