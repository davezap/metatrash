# Replace the old route-specific proxy rules inside the existing HTTPS VirtualHost.
# Requires mod_proxy, mod_proxy_http, mod_headers. Keep existing TLS configuration.
ProxyRequests Off
ProxyPreserveHost On
ProxyTimeout 60
ProxyAddHeaders On

# Discard supplied chains; mod_proxy adds the actual client address.
# Go rejects forwarded /healthz requests, including from loopback clients.
RequestHeader unset X-Forwarded-For
RequestHeader unset Forwarded
RequestHeader unset X-Forwarded-Host

# Go owns all application routes and serves only embedded application assets.
ProxyPass        / http://127.0.0.1:8080/
ProxyPassReverse / http://127.0.0.1:8080/

# Alternative: mount only /metatrash/ instead of the whole domain.
# Replace the two root ProxyPass lines above with these (do not use both).
# Start Go with: -public-url https://mydomain.com/metatrash/
# RedirectMatch 308 ^/metatrash$ /metatrash/
# ProxyPass        /metatrash/ http://127.0.0.1:8080/
# ProxyPassReverse /metatrash/ http://127.0.0.1:8080/
# Both sides must end in /; Apache strips the external prefix before proxying.
# With OAuth enabled under a folder, also pass root discovery (RFC 8414/9728):
# ProxyPass        /.well-known/oauth-authorization-server/metatrash http://127.0.0.1:8080/.well-known/oauth-authorization-server
# ProxyPass        /.well-known/oauth-protected-resource/metatrash/ http://127.0.0.1:8080/.well-known/oauth-protected-resource/
# Never log request bodies or Authorization headers (OAuth codes and tokens).
