# Add inside the existing HTTPS VirtualHost for metatrash.com.
# Requires mod_proxy, mod_proxy_http, mod_headers. Keep existing TLS configuration.
ProxyRequests Off
ProxyPreserveHost On
ProxyTimeout 60

# Apache adds the real client address. Do not accept a supplied forwarding chain.
RequestHeader unset X-Forwarded-For

ProxyPass        /api/ http://127.0.0.1:8080/api/
ProxyPassReverse /api/ http://127.0.0.1:8080/api/

# Exact MCP endpoint; no catch-all proxy. /healthz remains local-only.
# Explicit backreferences prevent Apache appending the original path again.
ProxyPassMatch  "^(/mcp)$" "http://127.0.0.1:8080$1"
ProxyPassReverse /mcp http://127.0.0.1:8080/mcp

# Human interface: expose only these routes, keeping /healthz local-only.
ProxyPassMatch "^(/)$" "http://127.0.0.1:8080$1"
ProxyPassMatch "^(/spaces/public/?)$" "http://127.0.0.1:8080$1"
ProxyPassMatch "^(/assets/style[.]css)$" "http://127.0.0.1:8080$1"
ProxyPassReverse /spaces/public/ http://127.0.0.1:8080/spaces/public/

# Passwordless account pages (0.4.0). Keep the explicit backreference.
ProxyPassMatch "^(/login(?:/send|/verify)?|/logout|/account)$" "http://127.0.0.1:8080$1"
ProxyPassReverse /login http://127.0.0.1:8080/login
ProxyPassReverse /account http://127.0.0.1:8080/account
