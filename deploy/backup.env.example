# /etc/metatrash-backup/backup.env (root:root, 0600). Read by metatrash-backup.
# Keep it out of /etc/metatrash: that folder is part of the backup.

# restic repository on Backblaze B2 through its S3 API. Use the bucket's
# endpoint as B2 shows it (Buckets -> Endpoint).
RESTIC_REPOSITORY=s3:https://s3.us-west-004.backblazeb2.com/metatrash-backup/restic
RESTIC_PASSWORD_FILE=/etc/metatrash-backup/restic-password
# B2 application key limited to the bucket: keyID and applicationKey.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional: a URL pinged after each run (healthchecks.io style; /fail is
# appended on failure), so a missed or failed backup is noticed.
#HEALTHCHECK_URL=https://hc-ping.com/<uuid>

# Defaults, change only if needed:
#DATA_DIR=/var/lib/metatrash
#CONFIG_DIR=/etc/metatrash
#STAGING_DIR=/var/backups/metatrash
#DATABASE=metatrash            # empty for a service without accounts
#CONFIG_EXCLUDE=totp-key       # names in CONFIG_DIR left out, space-separated
#CONFIG_EXTRA="/etc/systemd/system/metatrash.service /etc/systemd/system/metatrash.service.d"
#KEEP_DAILY=14
#KEEP_WEEKLY=8
#KEEP_MONTHLY=12
#PRUNE_WEEKDAY=7               # forget, prune and check on Sundays
