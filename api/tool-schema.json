            "description": "The GitHub folder, for example site/ (the folder holding the .metatrash.json with the github service)."
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "description": "Commit message: a short first line, then details if useful. At most 4000 characters."
          },
          "ifInState": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$",
            "description": "Optional state from pending (or read/list): push refuses if any file in the folder changed since then. Writes elsewhere in the space do not count."
