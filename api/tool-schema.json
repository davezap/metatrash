    {
      "name": "push",
      "description": "Send a GitHub folder's pending changes to GitHub as one commit on its branch, with your message; check pending first. All or nothing: it refuses (and sends nothing) when the folder has not been pulled, when GitHub moved ahead of the last pull or push (pull, then push again), when a change touches .github/workflows/, or when the folder's push mode is \"review\". Never forces. GitHub records the commit as the Metatrash app and signs it (Verified); the message names you in a Co-authored-by trailer (your GitHub account if you linked one under Connect GitHub, else your Metatrash username) and adds Metatrash-Space and Metatrash-Agent trailers. Files pull skipped stay on GitHub untouched; files .gitignore excludes are not sent. Nothing pending: upToDate, no commit. Changes written while a push runs stay pending. Needs write access. Limits: 1000 files, 40 MB, 10 pushes per space per 10 minutes. Errors: invalid_request, conflict (see message), state_mismatch (folder changed since ifInState), forbidden, payload_too_large, rate_limited, github_unavailable.",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "space": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,47}(/[a-z0-9][a-z0-9-]{0,47})?$",
            "description": "Space name. On /mcp/account: owner/slug from spaces, public, or a space ID."
          },
          "folder": {
            "type": "string",
