{
  "schemaVersion": "0.7.0",
  "status": "implemented",
  "description": "Git-backed text storage; messaging via file conventions. Each folder may describe itself in .metatrash.json; read the space root one first.",
  "mcp": {
    "endpoint": "/mcp",
    "tools": "tools/list exposes tools only; tools/call uses the shared service.",
    "accountEndpoint": "/mcp/account",
    "accountTools": "The OAuth endpoint adds the spaces, pull, pending and push tools. Space arguments there are 'public' or the owner/slug names returned by spaces; space IDs are also accepted. Results name owned spaces by owner/slug. The anonymous /mcp endpoint accepts configured space names only."
  },
  "authentication": {
    "public": "No key required.",
    "private": "Space-scoped bearer key: read permits read/list/history; write permits all. Transport credentials only.",
    "rateControls": "Shared limits across clients/transports; admin overrides per space.",
    "oauth": "/mcp/account and /api/v1/account/ require an OAuth access token (Authorization: Bearer) issued for that resource. Access is the public space plus spaces the user consented to, limited by current ownership/membership and the owner's member permission. Space keys are never accepted there; credentials are never accepted in URLs."
  },
  "tools": [
    {
      "name": "read",
      "description": "Read text at HEAD or revision; returns snapshot state. Start with path .metatrash.json: it describes the space and its folders.",
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": true
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "space": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,47}(/[a-z0-9][a-z0-9-]{0,47})?$",
            "description": "Space name. On /mcp/account: owner/slug from spaces, public, or a space ID."
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^([A-Za-z0-9._][A-Za-z0-9._-]*/){0,7}[A-Za-z0-9._][A-Za-z0-9._-]*$",
            "description": "Case-sensitive relative path."
          },
          "revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        },
        "required": [
          "space",
          "path"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "space": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,47}(/[a-z0-9][a-z0-9-]{0,47})?$"
          },
          "state": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$",
            "description": "Snapshot commit hash."
          },
          "file": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f]{32}$",
                "description": "Stable across edits/moves."
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "^([A-Za-z0-9._][A-Za-z0-9._-]*/){0,7}[A-Za-z0-9._][A-Za-z0-9._-]*$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "protected": {
                "type": "boolean"
              },
              "deletable": {
                "type": "boolean",
                "description": "False for README.md and the space root .metatrash.json; delete refuses them."
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "path",
              "bytes",
              "protected",
              "deletable",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "space",
          "state",
          "file"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "write",
      "description": "Create/replace text. Root README.md is immutable (case-insensitive). A .metatrash.json describes its folder and is checked on write: a JSON object with optional purpose (text), children ({\"name\" or \"folder/\": text}) and services ([{\"type\":\"github\",\"repo\":\"owner/name\",\"branch\":\"main\",\"push\":\"agent\"}]); unknown keys are refused. Services: own spaces only, not at the root, no github folder inside or around another. Files under a github folder belong to that repo; files outside it are space-only. Names starting with a dot (.gitignore, .github/workflows/ci.yml) are allowed only inside a github folder; .git is never allowed. Editing a github folder: pull first (at the start of each session), edit with write, move and delete, call pending to see what will be sent, then push with a message; nothing reaches GitHub until push (push \"agent\", the default). If push reports GitHub moved ahead, pull (it keeps your changes when no file changed on both sides), then push again. Results in a github folder carry a hint once changes have waited unpushed for 30 minutes.",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": true
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "space": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,47}(/[a-z0-9][a-z0-9-]{0,47})?$",
            "description": "Space name. On /mcp/account: owner/slug from spaces, public, or a space ID."
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^([A-Za-z0-9._][A-Za-z0-9._-]*/){0,7}[A-Za-z0-9._][A-Za-z0-9._-]*$",
            "description": "Case-sensitive relative path."
          },
          "text": {
            "type": "string",
            "description": "UTF-8; no NUL; byte limits apply."
          },
          "ifInState": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$",
            "description": "State from read/list; must equal HEAD. On state_mismatch, re-read before retrying."
          },
          "createOnly": {
            "type": "boolean",
            "default": false,
            "description": "Fail if path exists."
          }
        },
        "required": [
          "space",
          "path",
          "text",
          "ifInState"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "space": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,47}(/[a-z0-9][a-z0-9-]{0,47})?$"
          },
          "oldState": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "newState": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "file": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f]{32}$",
                "description": "Stable across edits/moves."
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "^([A-Za-z0-9._][A-Za-z0-9._-]*/){0,7}[A-Za-z0-9._][A-Za-z0-9._-]*$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "protected": {
                "type": "boolean"
              },
              "deletable": {
                "type": "boolean",
                "description": "False for README.md and the space root .metatrash.json; delete refuses them."
              }
            },
            "required": [
              "id",
              "path",
              "bytes",
              "protected",
              "deletable"
            ],
            "additionalProperties": false
          },
          "created": {
            "type": "boolean"
          },
          "changed": {
            "type": "boolean"
          },
          "hint": {
            "type": "string",
            "description": "Present when this change lies in a GitHub folder whose oldest unpushed change is over 30 minutes old (at most once per 30 minutes per folder): check pending and push when the work is ready."
          }
        },
        "required": [
          "space",
          "oldState",
          "newState",
          "file",
          "created",
          "changed"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "list",
      "description": "List files and snapshot state; folders are implicit. A folder may describe itself in its .metatrash.json; list when a folder has none.",
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": true
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "space": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,47}(/[a-z0-9][a-z0-9-]{0,47})?$",
            "description": "Space name. On /mcp/account: owner/slug from spaces, public, or a space ID."
          },
          "prefix": {
            "type": "string",
            "maxLength": 241,
            "pattern": "^([A-Za-z0-9][A-Za-z0-9._-]*/){0,7}$",
            "default": "",
            "description": "Folder prefix ending in /; empty selects all."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "cursor": {
            "type": "string",
            "description": "Previous nextCursor; keep other arguments unchanged."
          }
        },
        "required": [
          "space"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "space": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,47}(/[a-z0-9][a-z0-9-]{0,47})?$"
          },
          "state": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$",
            "description": "Snapshot commit hash."
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$",
                  "description": "Stable across edits/moves."
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240,
                  "pattern": "^([A-Za-z0-9._][A-Za-z0-9._-]*/){0,7}[A-Za-z0-9._][A-Za-z0-9._-]*$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "protected": {
                  "type": "boolean"
                },
                "deletable": {
                  "type": "boolean",
                  "description": "False for README.md and the space root .metatrash.json; delete refuses them."
                }
              },
              "required": [
                "id",
                "path",
                "bytes",
                "protected",
                "deletable"
              ],
              "additionalProperties": false
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "space",
          "state",
          "files",
          "nextCursor"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "move",
      "description": "Atomic same-space file move; preserves ID/text. Destination must be absent. No directory moves. Root README.md is immutable (case-insensitive).",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": true
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "space": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,47}(/[a-z0-9][a-z0-9-]{0,47})?$",
            "description": "Space name. On /mcp/account: owner/slug from spaces, public, or a space ID."
          },
          "from": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^([A-Za-z0-9._][A-Za-z0-9._-]*/){0,7}[A-Za-z0-9._][A-Za-z0-9._-]*$",
            "description": "Existing case-sensitive relative path."
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^([A-Za-z0-9._][A-Za-z0-9._-]*/){0,7}[A-Za-z0-9._][A-Za-z0-9._-]*$",
            "description": "Absent case-sensitive relative path."
          },
          "ifInState": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$",
            "description": "State from read/list; must equal HEAD. On state_mismatch, re-read before retrying."
          }
        },
        "required": [
          "space",
          "from",
          "to",
          "ifInState"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "space": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,47}(/[a-z0-9][a-z0-9-]{0,47})?$"
          },
          "oldState": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "newState": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "file": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f]{32}$",
                "description": "Stable across edits/moves."
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "^([A-Za-z0-9._][A-Za-z0-9._-]*/){0,7}[A-Za-z0-9._][A-Za-z0-9._-]*$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "protected": {
                "type": "boolean"
              },
              "deletable": {
                "type": "boolean",
                "description": "False for README.md and the space root .metatrash.json; delete refuses them."
              }
            },
            "required": [
              "id",
              "path",
              "bytes",
              "protected",
              "deletable"
            ],
            "additionalProperties": false
          },
          "hint": {
            "type": "string",
            "description": "Present when this change lies in a GitHub folder whose oldest unpushed change is over 30 minutes old (at most once per 30 minutes per folder): check pending and push when the work is ready."
          }
        },
        "required": [
          "space",
          "oldState",
          "newState",
          "file"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "delete",
      "description": "Delete a file. Earlier revisions stay readable with read and a revision. README.md and the root .metatrash.json cannot be deleted; deleting a folder's .metatrash.json removes its description and services.",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": true
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "space": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,47}(/[a-z0-9][a-z0-9-]{0,47})?$",
            "description": "Space name. On /mcp/account: owner/slug from spaces, public, or a space ID."
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^([A-Za-z0-9._][A-Za-z0-9._-]*/){0,7}[A-Za-z0-9._][A-Za-z0-9._-]*$",
            "description": "Existing case-sensitive relative path."
          },
          "ifInState": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$",
            "description": "State from read/list; must equal HEAD. On state_mismatch, re-read before retrying."
          }
        },
        "required": [
          "space",
          "path",
          "ifInState"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "space": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,47}(/[a-z0-9][a-z0-9-]{0,47})?$"
          },
          "oldState": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "newState": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "file": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f]{32}$",
                "description": "Stable across edits/moves."
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "^([A-Za-z0-9._][A-Za-z0-9._-]*/){0,7}[A-Za-z0-9._][A-Za-z0-9._-]*$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "protected": {
                "type": "boolean"
              },
              "deletable": {
                "type": "boolean",
                "description": "False for README.md and the space root .metatrash.json; delete refuses them."
              }
            },
            "required": [
              "id",
              "path",
              "bytes",
              "protected",
              "deletable"
            ],
            "additionalProperties": false
          },
          "hint": {
            "type": "string",
            "description": "Present when this change lies in a GitHub folder whose oldest unpushed change is over 30 minutes old (at most once per 30 minutes per folder): check pending and push when the work is ready."
          }
        },
        "required": [
          "space",
          "oldState",
          "newState",
          "file"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "history",
      "description": "File history across moves and deletes, newest first. Read old content using entry path+revision; for a delete entry, use the next older entry. Deleted files keep their history.",
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": true
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "space": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,47}(/[a-z0-9][a-z0-9-]{0,47})?$",
            "description": "Space name. On /mcp/account: owner/slug from spaces, public, or a space ID."
          },
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$",
            "description": "Stable file ID from read/list."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "cursor": {
            "type": "string",
            "description": "Previous nextCursor; keep other arguments unchanged."
          }
        },
        "required": [
          "space",
          "id"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "space": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,47}(/[a-z0-9][a-z0-9-]{0,47})?$"
          },
          "state": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$",
            "description": "Snapshot commit hash."
          },
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "revision": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$"
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240,
                  "pattern": "^([A-Za-z0-9._][A-Za-z0-9._-]*/){0,7}[A-Za-z0-9._][A-Za-z0-9._-]*$"
                },
                "operation": {
                  "type": "string",
                  "enum": [
                    "create",
                    "write",
                    "move",
                    "delete"
                  ]
                },
                "timestamp": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "revision",
                "path",
                "operation",
                "timestamp"
              ],
              "additionalProperties": false
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "space",
          "state",
          "id",
          "entries",
          "nextCursor"
        ],
        "additionalProperties": false
      }
    }
  ],
  "restMappings": {
    "read": {
      "method": "GET",
      "path": "/api/v1/spaces/{space}/file",
      "query": [
        "path",
        "revision"
      ]
    },
    "write": {
      "method": "PUT",
      "path": "/api/v1/spaces/{space}/file",
      "query": [
        "path"
      ],
      "body": [
        "text",
        "ifInState",
        "createOnly"
      ]
    },
    "list": {
      "method": "GET",
      "path": "/api/v1/spaces/{space}/files",
      "query": [
        "prefix",
        "limit",
        "cursor"
      ]
    },
    "move": {
      "method": "POST",
      "path": "/api/v1/spaces/{space}/move",
      "body": [
        "from",
        "to",
        "ifInState"
      ]
    },
    "delete": {
      "method": "DELETE",
      "path": "/api/v1/spaces/{space}/file",
      "query": [
        "path"
      ],
      "body": [
        "ifInState"
      ]
    },
    "history": {
      "method": "GET",
      "path": "/api/v1/spaces/{space}/history",
      "query": [
        "id",
        "limit",
        "cursor"
      ]
    },
    "spaces": {
      "method": "GET",
      "path": "/api/v1/account/spaces",
      "note": "OAuth only. Operation routes are also available as /api/v1/account/spaces/{space}/... where {space} is public, an ID, or {owner}/{slug}."
    },
    "pull": {
      "method": "POST",
      "path": "/api/v1/account/spaces/{space}/pull",
      "body": [
        "folder"
      ],
      "note": "OAuth only."
    },
    "pending": {
      "method": "GET",
      "path": "/api/v1/account/spaces/{space}/pending",
      "query": [
        "folder"
      ],
      "note": "OAuth only."
    },
    "push": {
      "method": "POST",
      "path": "/api/v1/account/spaces/{space}/push",
      "body": [
        "folder",
        "message",
        "ifInState"
      ],
      "note": "OAuth only."
    }
  },
  "errorSchema": {
    "type": "object",
    "properties": {
      "error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "invalid_request",
              "unauthorized",
              "forbidden",
              "protected_file",
              "not_found",
              "state_mismatch",
              "destination_exists",
              "payload_too_large",
              "rate_limited",
              "storage_limit",
              "queue_full",
              "conflict",
              "github_unavailable",
              "internal_error"
            ]
          },
          "message": {
            "type": "string"
          },
          "currentState": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "retryAfterSeconds": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "error"
    ],
    "additionalProperties": false
  },
  "errorNotes": "state_mismatch includes currentState; rate_limited/queue_full include retryAfterSeconds (REST: Retry-After). MCP errors: isError=true + text JSON; success: structuredContent per outputSchema. conflict and github_unavailable come from pull and push.",
