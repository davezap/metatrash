          },
          "changes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "change": {
                  "type": "string",
                  "enum": [
                    "added",
                    "modified",
                    "deleted"
                  ]
                },
                "note": {
                  "type": "string"
                },
                "baseState": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$",
                  "description": "Space revision holding the previous version; read the path at it to compare. Absent for added files and for files pull skipped."
                }
