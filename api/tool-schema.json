    {
      "name": "pull",
      "description": "Fill or update a GitHub folder from its repository (the github service in the folder's .metatrash.json: repo and branch, default main) and record the commit it came from (the baseline for pending and push). Call it at the start of each session. The first pull needs the folder empty apart from .metatrash.json files, or holding identical copies; it refuses and names any other files. Later pulls bring the folder to the branch's latest commit (creating, updating and deleting files). Files changed here since the last pull or push stay as they are and stay pending, as long as GitHub did not change the same files; a file changed on both sides stops the pull (conflict, naming the files; no line merging). UTF-16 and UTF-32 files with a byte order mark are converted to UTF-8 with a UTF-8 byte order mark and listed under converted; GitHub keeps the original until the file is edited and pushed. Files Metatrash cannot hold (binary, other encodings such as Latin-1, over the file limit, names outside the path rules, symbolic links, submodules, .metatrash.json) are skipped and listed; they stay on GitHub untouched. Needs write access. Errors: conflict (see message), forbidden (no GitHub connection or the app cannot reach the repo), storage_limit, github_unavailable.",
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": true,
        "openWorldHint": true
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "space": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,47}(/[a-z0-9][a-z0-9-]{0,47})?$",
            "description": "Space name. On /mcp/account: owner/slug from spaces, public, or a space ID."
          },
          "folder": {
            "type": "string",
            "minLength": 1,
            "maxLength": 241,
            "pattern": "^([A-Za-z0-9._][A-Za-z0-9._-]*/){0,6}[A-Za-z0-9._][A-Za-z0-9._-]*/?$",
            "description": "The GitHub folder, for example site/ (the folder holding the .metatrash.json with the github service)."
          }
        },
        "required": [
          "space",
          "folder"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "space": {
            "type": "string"
          },
          "folder": {
            "type": "string",
            "description": "Folder prefix, ending in /."
          },
          "repo": {
            "type": "string"
          },
          "branch": {
            "type": "string"
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$",
            "description": "Repository commit the folder now matches."
          },
          "oldState": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "newState": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$",
            "description": "Space state after the pull; equals oldState when upToDate."
          },
          "upToDate": {
            "type": "boolean",
            "description": "True when the folder already had the branch's latest commit; nothing was written (local changes stay pending)."
          },
          "created": {
            "type": "integer",
            "minimum": 0
          },
          "updated": {
            "type": "integer",
            "minimum": 0
          },
          "deleted": {
            "type": "integer",
            "minimum": 0
          },
          "unchanged": {
            "type": "integer",
            "minimum": 0
          },
          "skipped": {
            "type": "array",
            "maxItems": 50,
            "description": "Repository files not held in the folder (first 50), by path in the repository.",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "reason"
              ],
              "additionalProperties": false
            }
          },
          "skippedCount": {
            "type": "integer",
            "minimum": 0
          },
          "converted": {
            "type": "array",
            "maxItems": 50,
            "description": "Files held as UTF-8 (with a UTF-8 byte order mark) that are UTF-16 or UTF-32 on GitHub (first 50), by path in the space.",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "encoding": {
                  "type": "string",
                  "enum": [
                    "UTF-16 LE",
                    "UTF-16 BE",
                    "UTF-32 LE",
                    "UTF-32 BE"
                  ]
                }
              },
              "required": [
                "path",
                "encoding"
              ],
              "additionalProperties": false
            }
          },
          "convertedCount": {
            "type": "integer",
            "minimum": 0
          },
          "localChanges": {
            "type": "integer",
            "minimum": 0,
            "description": "Files changed here since the last pull or push that the pull left in place; they stay pending for push."
          }
        },
        "required": [
          "space",
          "folder",
          "repo",
          "branch",
          "commit",
          "oldState",
          "newState",
          "upToDate",
          "created",
          "updated",
          "deleted",
          "unchanged",
          "skipped",
          "skippedCount",
          "converted",
          "convertedCount",
          "localChanges"
        ],
        "additionalProperties": false
      }
